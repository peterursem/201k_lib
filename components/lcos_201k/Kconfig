    config LCOS_SPI_CLOCK_HZ
        int "SPI clock frequency (Hz)"
        default 400000
        range 100000 1500000
        help
            SPI clock for configuration interface. Max 1.5 MHz per datasheet.

    config LCOS_INIT_DELAY_MS
        int "Delay between register writes (ms)"
        default 5

    config LCOS_ENABLE_REG_VERIFY
